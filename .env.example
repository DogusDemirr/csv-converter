# Leave unset for local/staging: noindex, robots disallow, empty sitemap.
# Set the real HTTPS origin before a production build. No path or trailing routes.
SITE_URL=
# Preview always suppresses canonical/indexing, even with an inherited SITE_URL.
# Do not enable production until ownership/TLS and all launch blockers are reviewed.
DEPLOYMENT_ENV=preview
# Only used by build:pages. Set the exact approved branch in the host environment.
PRODUCTION_BRANCH=
